# Публичный адрес API для фронтенда.
# Скопируйте файл в .env и при необходимости измените значение:
#     cp .env.example .env
#
# Файл .env локальный и в репозиторий не попадает (лежит в .gitignore).
# В коде значение никак не зашито — только import.meta.env.VITE_API_URL (п. 3).

# локальная разработка: прямое обращение к API бэкенда (CORS разрешён)
VITE_API_URL=http://localhost:5286/api

# контейнерная сборка (значение по умолчанию в Dockerfile): запросы идут
# через nginx сервиса web -> http://api:8080
# VITE_API_URL=/api
