# =============================================================================
# Шаблон конфигурации. Скопируйте файл в .env и подставьте свои значения:
#     cp .env.example .env      (Windows: copy .env.example .env)
#
# В репозитории хранится ТОЛЬКО этот шаблон без реальных секретов.
# Все значения попадают в приложение исключительно как переменные окружения
# (12-фактор, п. 3 и п. 4).
# =============================================================================

# --- PostgreSQL (присоединяемый ресурс, п. 4) ---
POSTGRES_DB=habits
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Строка подключения бэкенда. Смена СУБД/провайдера = изменение только этой
# переменной, код не меняется (п. 4).
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=habits;Username=postgres;Password=change_me

# --- Бэкенд (п. 7: адрес и порт привязки только из окружения) ---
# Вместо PORT можно использовать стандартный ASPNETCORE_URLS
PORT=8080
ASPNETCORE_ENVIRONMENT=Production

# --- Фронтенд: публичный адрес API, который используется при сборке UI (п. 3) ---
# /api — nginx контейнера web проксирует запросы на бэкенд
VITE_API_URL=/api

# --- Порты на хосте (для локального запуска) ---
API_PORT=5286
WEB_PORT=3000
